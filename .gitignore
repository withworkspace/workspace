bin/
*.out
ws.local.toml
.DS_Store
.idea/

# The web UI, built by `just build` from web/. Only .gitkeep is committed:
# go:embed needs something in the folder when the UI hasn't been built.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# What's new, as a build found it (scripts/whatsnew): only .gitkeep is
# committed, for go:embed.
/internal/whatsnew/gen/*
!/internal/whatsnew/gen/.gitkeep
