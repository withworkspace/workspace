#!/bin/sh
# A stand-in for Claude Code, which the marketing seed puts first on its
# try's PATH (scripts/seeds/marketing.sh): crew there are launched as
# Claude Code's, so the web UI shows them as it shows real ones, and no
# agent runs. The seed does their work and says what they'd report.
#
# Launched as crew (in a terminal), it waits to be closed. Asked to answer
# without one (-p: the orchestrator, a conversation, a judge), it says
# there's nobody here and fails.
for arg in "$@"; do
	case "$arg" in
	--) break ;;
	-p | --print)
		echo "No agent runs in this try: scripts/seeds/marketing.sh stands in for Claude Code." >&2
		exit 1
		;;
	-v | --version)
		echo "0.0.0 (a stand-in: scripts/seeds/marketing.sh)"
		exit 0
		;;
	esac
done
echo "A stand-in for Claude Code: no agent runs in this try (scripts/seeds/marketing.sh)."
while :; do sleep 3600; done
